rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check helper
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == 'awoyinfasolomon1@gmail.com' || request.auth.token.admin == true);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /user_licenses/{userId} {
      allow read, write: if request.auth != null;
    }

    match /licenses/{code} {
      allow read, write: if request.auth != null;
    }
  }
}
