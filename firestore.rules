rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'awoyinfasolomon1@gmail.com' ||
        request.auth.token.email == 'awoyinfataiwo20@gmail.com' ||
        request.auth.token.email == 'solvatechofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Global System Settings Collection (Railway Backend URL discovery for all visitors)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Licenses Collection
    match /licenses/{code} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // User License Activations Collection
    match /user_licenses/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // WhatsApp Group Settings Collection (Persistent Anti-Link, Anti-Bot, Anti-Status, Warnings across restarts & reconnects)
    match /group_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Group Event Idempotency & Distributed Claim Collection (Auto Welcome / Auto Goodbye coordination)
    match /group_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp Baileys Sessions Collection (Session persistence and fast reconnection)
    match /whatsapp_sessions/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp Number to UID Locks Collection
    match /number_locks/{phoneNumber} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // UID to WhatsApp Number Locks Collection
    match /user_number_locks/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Number History Association & Deletion Trail Collection
    match /number_history/{historyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Admin Audit Logs Collection
    match /admin_audit_logs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Referral Purchases Collection
    match /referral_purchases/{purchaseId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Referral Rewards Collection
    match /referral_rewards/{rewardId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Referral Claims Collection
    match /referral_claims/{claimId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Deleted Messages (DDD Anti-Delete Recovery) Collection
    match /deleted_messages/{recordId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // User Recovery & Privacy Preferences Collection
    match /user_preferences/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // User Settings Collection
    match /user_settings/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Persistent Meta Continuous AI Chat Sessions
    match /meta_chats/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
